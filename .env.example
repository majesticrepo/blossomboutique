# Copy this file to .env and fill in your real values. Never commit .env.
#
# Get these from https://dashboard.stripe.com/apikeys (use the "Standard
# keys" — publishable + secret — and switch on "test mode" while developing).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# From the webhook endpoint you create in the Stripe Dashboard
# (Developers → Webhooks) or from `stripe listen` while testing locally.
STRIPE_WEBHOOK_SECRET=whsec_...

# Where the site is served from. Update to your real domain once deployed.
DOMAIN=http://localhost:4242
PORT=4242
